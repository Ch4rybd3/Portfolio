NODE_ENV=production

# Port INTERNE app <-> nginx (réseau Docker uniquement, pas exposé sur l'hôte)
PORT=3000

# Écoute publique de nginx sur l'hôte :
#   BIND_ADDR=0.0.0.0   -> accessible depuis le réseau (défaut)
#   BIND_ADDR=127.0.0.1 -> localhost uniquement (ex. derrière un reverse proxy local)
BIND_ADDR=0.0.0.0
HTTP_PORT=8080

SESSION_SECRET=change-this-to-a-long-random-string

# false en HTTP local, true en production derrière Cloudflare (HTTPS)
COOKIE_SECURE=false

# Chemins des données persistées (montés en volume Docker)
DATA_DIR=/app/data
UPLOADS_DIR=/app/uploads
